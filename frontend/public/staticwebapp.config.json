{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/redirect.html", "/*.{ico,png,svg,json,txt,css,js,map}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  }
}
