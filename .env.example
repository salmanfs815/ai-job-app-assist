# Copy to .env. Every variable the app reads is listed here; none are required for a
# local mock-mode run. Never commit real values.

# --- Runtime -------------------------------------------------------------------------
# local | production. Unset means production (the safe default for a deployed image).
ENVIRONMENT=local
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- LLM -----------------------------------------------------------------------------
# Leave empty for deterministic mock output (no cost, no network).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_MAX_OUTPUT_TOKENS=8000
# Optional price override in USD per 1M tokens (defaults come from app/domain/pricing.py).
# LLM_INPUT_COST_PER_1M_USD=0.40
# LLM_OUTPUT_COST_PER_1M_USD=1.60

# --- Limits and spend protection -------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BURST=60
RATE_LIMIT_REFILL_PER_SECOND=1
RATE_LIMIT_EXPENSIVE_COST=10
# Reverse proxies in front of the API that set X-Forwarded-For (Azure Container Apps = 1).
TRUSTED_PROXY_HOPS=1
# Salt for hashing guest IP addresses before they are stored. Use a long random secret in production.
IP_HASH_SALT=local-development-salt
USER_DAILY_GENERATION_LIMIT=20
GUEST_DAILY_GENERATION_LIMIT=3
GLOBAL_DAILY_LLM_BUDGET_USD=1.00

# --- Persistence (optional) --------------------------------------------------------------
# false = in-memory repositories (data is lost on restart).
PERSISTENCE_ENABLED=false
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE_NAME=jobassist
COSMOS_CONTAINER_NAME=results
COSMOS_USAGE_CONTAINER_NAME=usage

# --- Document parsing ----------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
VITE_MAX_UPLOAD_BYTES=5242880
ENABLE_PDF_OCR_FALLBACK=true
TESSERACT_CMD=
